#!/usr/bin/env bash
# ebrain — CLI unificado del harness/knowledge layer. Dispatcher fino sobre las piezas canónicas.
# Instalado como ~/.local/bin/ebrain (launcher) → este archivo. Todo vive en $EBRAIN_HOME (~/eBrain).
set -uo pipefail

EBRAIN_HOME="${EBRAIN_HOME:-$HOME/eBrain}"
CORE="$EBRAIN_HOME/harness/core"
SCRIPTS="$EBRAIN_HOME/scripts"
CFG="$HOME/.config/ebrain"

# `run_bun` hace `cd` a un dir neutral ANTES de correr el script (ver comentario abajo) — eso pisa
# `process.cwd()` dentro del script bun. `sessions new` (SPRINT-TUI 6.1.6) SÍ le importa el cwd real
# desde donde se invocó `ebrain` (default de la sesión tmux si no se pasa --cwd explícito) → lo
# capturamos ACÁ, antes de cualquier cd, y lo exportamos para que sessions.ts pueda usarlo como
# fallback. Inofensivo para spend/fleet/memory (no leen esta var).
export EBRAIN_CALLER_CWD="$PWD"

run() { local f="$1"; shift; if [ -x "$f" ] || [ -f "$f" ]; then bash "$f" "$@"; else echo "ebrain: '$f' no existe todavía (¿fase pendiente?)." >&2; return 127; fi; }

# run_bun <script.ts> [args...] — corre un cli/*.ts (bun) desde un cwd neutral (~/.config/ebrain/wd,
# el mismo que usan gbrain-run/ebrain-route): Bun auto-carga un .env del cwd, y `ebrain` puede
# invocarse desde CUALQUIER directorio (incl. uno de cliente con su propio .env) — este cd evita
# que ese .env ajeno entre al proceso. Los cli/*.ts nuevos (spend/fleet/memory) no tocan secretos,
# pero el patrón se mantiene por consistencia y defensa en profundidad.
BUN_BIN="${BUN_BIN:-$HOME/.bun/bin/bun}"; command -v bun >/dev/null 2>&1 && BUN_BIN=bun
run_bun() {
  local f="$1"; shift
  if [ ! -f "$f" ]; then echo "ebrain: '$f' no existe todavía (¿fase pendiente?)." >&2; return 127; fi
  if ! command -v "$BUN_BIN" >/dev/null 2>&1; then echo "ebrain: 'bun' no disponible ($BUN_BIN)." >&2; return 127; fi
  (cd "$CFG/wd" 2>/dev/null || cd /tmp; exec "$BUN_BIN" run "$f" "$@")
}

usage() {
  cat <<'EOF'
ebrain — capa unificada de harness + memoria agéntica (provider-agnostic)

  ebrain remember [--project S] [--tags a,b] "<learning>"   escribir a memoria agéntica permanente
  ebrain q "<pregunta>"                                      buscar (fan-out cross-source)
  ebrain route --cap <cap> "<prompt>"                        one-shot ruteado (stack OpenRouter capado)
  ebrain harness install <agent>                             instalar/actualizar el harness de un agente
  ebrain harness doctor [agent]                              verificar el harness de UN agente (guard/hooks/mcp)
  ebrain harness status                                      estado de la flota harness + modo MCP
  ebrain doctor [--json]                                     salud CKIS completa (launchers/config/contract/sources/gasto)
  ebrain status [--json]                                     snapshot rápido (brain/gasto/flota/memoria)
  ebrain ui                                                   TUI interactivo (sessions + launch router + memory/routing/doctor)
  ebrain spend [--json]                                      gasto MTD por capacidad vs cap de routing.yaml
  ebrain routing [--json]                                    stack OpenRouter: cadenas, modelos, pricing y gasto
  ebrain fleet [--json]                                      salud + clase RAM (heavy|light) de los 6 adapters
  ebrain memory recent [--json] [--limit N]                  últimos learnings + sesiones (agent-memory + Dev Brain)
  ebrain sessions list [--json]                               sesiones tmux ebr-* activas
  ebrain sessions new <agent> <slug> [--cwd D] [--json]       nueva sesión tmux (harness env inyectado; deny-list cliente)
  ebrain sessions peek <name> [--lines N] [--json]            capture-pane (scrubbeado — cero secretos crudos)
  ebrain sessions send <name> "<texto>" --yes [--json]        send-keys (exige --yes)
  ebrain sessions kill <name> --yes [--json]                  kill-session (exige --yes)
  ebrain advise "<tarea>" [--json]                            advisor v0: carril/agente/modelo/costo recomendado (NUNCA lanza)
  ebrain up [--json]                                          boot plug-and-play: daemon + token + onboard + smoke
  ebrain onboard [--all|agent] [--json]                       registrar MCP HTTP de agentes detectados
  ebrain daemon {start|stop|status|restart}                  host de cerebro compartido HTTP-MCP (:8541 loopback, dueño del lock)
  ebrain norms render <archivo>                              render del bloque de normas gestionado
  ebrain federate sessions|skills                            barrer .brain/ o skills a la memoria federada
  ebrain help

Agentes soportados por install: claude · codex · gemini · generic
EOF
}

cmd="${1:-help}"; shift || true
case "$cmd" in
  remember)  run "$CORE/remember.sh" "$@" ;;
  q|query)   run "$SCRIPTS/ebrain-q" "$@" ;;
  doctor)    run "$CORE/doctor.sh" "$@" ;;
  status)    run "$CORE/status.sh" "$@" ;;
  spend)     run_bun "$EBRAIN_HOME/cli/spend.ts" "$@" ;;
  routing)   run_bun "$EBRAIN_HOME/cli/routing.ts" "$@" ;;
  fleet)     run_bun "$EBRAIN_HOME/cli/fleet.ts" "$@" ;;
  memory)    run_bun "$EBRAIN_HOME/cli/memory.ts" "$@" ;;
  sessions)  run_bun "$EBRAIN_HOME/cli/sessions.ts" "$@" ;;
  advise)    run_bun "$EBRAIN_HOME/cli/advise.ts" "$@" ;;
  up)         run "$SCRIPTS/ebrain-up" up "$@" ;;
  onboard)    run "$SCRIPTS/ebrain-up" onboard "$@" ;;
  daemon)    run "$SCRIPTS/ebrain-daemon" "$@" ;;
  route)     if [ -x "$CFG/ebrain-route" ]; then "$CFG/ebrain-route" "$@"; else echo "ebrain: falta $CFG/ebrain-route" >&2; exit 127; fi ;;
  ui)
    # Guard BEFORE run_bun: an interactive alt-screen app needs a real terminal —
    # TERM unset/dumb means no ANSI escapes will render sanely (piped output, cron,
    # a dumb serial console). app.ts's own min-80x24 self-check (buildFrame) covers
    # the OTHER half of "can this actually run" once a real terminal is confirmed.
    if [ -z "${TERM:-}" ] || [ "$TERM" = "dumb" ]; then
      echo "ebrain ui: hace falta una terminal interactiva real (TERM no definido o 'dumb')." >&2
      exit 1
    fi
    run_bun "$EBRAIN_HOME/tui/src/app.ts" "$@" ;;
  harness)
    sub="${1:-}"; shift || true
    all_agents() { for m in "$EBRAIN_HOME"/harness/adapters/*/manifest.yaml; do [ -f "$m" ] && basename "$(dirname "$m")"; done; }
    case "$sub" in
      install)
        if [ "${1:-}" = "--all" ]; then
          shift; rc=0; for a in $(all_agents); do echo "### install $a ###"; bash "$CORE/install.sh" "$@" "$a" || rc=1; done; exit $rc
        else run "$CORE/install.sh" "$@"; fi ;;
      doctor)
        # sin agente o --all → toda la flota (ideal para cron: rc=1 si alguno tiene pendientes)
        if [ -z "${1:-}" ] || [ "${1:-}" = "--all" ]; then
          rc=0; for a in $(all_agents); do bash "$CORE/install.sh" --doctor "$a" || rc=1; done
          echo "── flota: $([ "$rc" = 0 ] && echo 'toda OK' || echo 'hay pendientes (rc=1)') ──"; exit $rc
        else run "$CORE/install.sh" --doctor "$@"; fi ;;
      status)
        rc=0; for a in $(all_agents); do bash "$CORE/install.sh" --doctor "$a" || rc=1; done
        echo "── flota: $([ "$rc" = 0 ] && echo 'toda OK' || echo 'hay pendientes (rc=1)') ──"; exit $rc ;;
      *) echo "ebrain harness: usá 'install <agent>|--all', 'doctor [agent|--all]' o 'status'." >&2; exit 2 ;;
    esac ;;
  norms)
    sub="${1:-}"; shift || true
    case "$sub" in
      render) run "$CORE/render-norms.sh" "$@" ;;
      *) echo "ebrain norms: usá 'render <archivo>'." >&2; exit 2 ;;
    esac ;;
  federate)
    sub="${1:-}"; shift || true
    case "$sub" in
      sessions) run "$SCRIPTS/sessions-federate" "$@" ;;
      skills)   run "$SCRIPTS/skills-federate" "$@" ;;
      *) echo "ebrain federate: usá 'sessions' o 'skills'." >&2; exit 2 ;;
    esac ;;
  help|-h|--help) usage ;;
  *) echo "ebrain: subcomando desconocido '$cmd'." >&2; usage; exit 2 ;;
esac
