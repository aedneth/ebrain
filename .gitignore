# vendor: clones read-only de upstream (gbrain/gstack) — nunca se versionan aquí
vendor/

# secretos: jamás en el repo (GUARDRAILS §1)
*.env
.env
*.pem
*credentials*

# runtime
# No trailing slash: `node_modules/` matches only real directories, so a `node_modules` SYMLINK
# (created when running the suite against a shared install) slipped past it and got committed once,
# breaking CI's `bun install` with ENOENT. The bare name matches the symlink too.
node_modules
vendor/gbrain/node_modules
website/node_modules
.gbrain/

# log de gasto (puede contener metadata sensible; GUARDRAILS §1/§4)
spend.jsonl
memory/
# Public documentation is source, not runtime memory.
!docs/memory/
!docs/memory/*.md

# harness — backups locales del render de normas (no versionar)
harness/.backups/

# per-project brain (norma CKIS: NUNCA versionar .brain/.claude/graphify-out)
# ebrain se auto-registra en Dev Brain vía brain-init (F5.4); su .brain y su
# .claude/settings.json son runtime local, no artefactos del repo.
.brain/
.claude/
graphify-out/

# F10.3 static documentation build output
website/dist/
website/.astro/
.vercel/

# Working notes, decision records, phase reports and the operator's own agent instructions.
# They stay on disk and out of a public checkout.
/docs/internal/

# Generated by scripts/skills-federate from whatever sources this machine federates. It is a
# catalogue of the operator's own skills, so it is machine state, not project source.
/overlay/skills/registry.yaml
