---
import { getCollection, getEntry, render } from "astro:content";

import DocsLayout from "../../layouts/DocsLayout.astro";
import { ORDERED_DOCS, docById } from "../../lib/navigation";

export async function getStaticPaths() {
  const entries = await getCollection("publicDocs");
  return entries.flatMap((entry) => ORDERED_DOCS.some((doc) => doc.id === entry.id) ? [{ params: { slug: entry.id }, props: { id: entry.id } }] : []);
}

const { id } = Astro.props;
const doc = docById(id);
const entry = await getEntry("publicDocs", id);
if (!doc || !entry) throw new Error(`unknown public documentation entry: ${id}`);
const { Content, headings } = await render(entry);
---

<DocsLayout activeId={id} title={doc.title} description={doc.description} headings={headings}>
  <Content />
</DocsLayout>
