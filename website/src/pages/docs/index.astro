---
import DocsLayout from "../../layouts/DocsLayout.astro";
import { DOC_SECTIONS, docRoute } from "../../lib/navigation";
---

<DocsLayout title="Documentation" description="Install eBrain, wire your agents, and understand what reaches each prompt.">
  <p class="eyebrow">eBrain documentation</p>
  <h1>Documentation for persistent agent memory.</h1>
  <p class="article-lede">Install eBrain, wire your agents, and see what reaches each prompt. Each page states what a surface does and what it does not.</p>
  <section class="hub-paths" aria-labelledby="hub-paths-title">
    <h2 id="hub-paths-title">Pick your path</h2>
    <div>
      {[
        { title: "Install eBrain", description: "Install from scratch, boot one shared daemon, and see what still has to be set up.", href: docRoute("getting-started/quickstart") },
        { title: "Wire an agent", description: "How Codex, Antigravity and Hermes are wired, guarded and checked against what each one reads.", href: docRoute("guides/agents") },
        { title: "Understand memory", description: "What arrives with each prompt, what the index holds and how learnings are written.", href: docRoute("concepts/memory") },
        { title: "Bring your retrieval", description: "The contract between an agent's prompt hook and the command that retrieves for your brain.", href: docRoute("reference/prompt-context") },
      ].map((path) => (
        <a class="hub-path" href={path.href}>
          <h3>{path.title}</h3>
          <p>{path.description}</p>
          <span>Open guide <img src="/icons/arrow-right.svg" alt="" width="16" height="16" /></span>
        </a>
      ))}
    </div>
  </section>
  <section class="hub-sections" aria-labelledby="hub-sections-title">
    <h2 id="hub-sections-title">All documentation</h2>
    {DOC_SECTIONS.map((section) => (
      <section>
        <h3>{section.title}</h3>
        <ul>
          {section.links.map((doc) => <li><a href={docRoute(doc.id)}>{doc.title}<span>{doc.description}</span></a></li>)}
        </ul>
      </section>
    ))}
  </section>
</DocsLayout>
