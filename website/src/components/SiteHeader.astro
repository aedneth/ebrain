---
import { REPOSITORY_URL } from "../lib/navigation";

const currentPath = Astro.url.pathname;
const docsActive = currentPath.startsWith("/docs");
---

<header class="site-header">
  <a class="brand" href="/" aria-label="eBrain home">
    <img src="/assets/ebrain-wordmark.svg" alt="eBrain" width="153" height="30" />
  </a>
  <nav class="primary-nav" aria-label="Primary navigation">
    <a href="/" aria-current={currentPath === "/" ? "page" : undefined}>Home</a>
    <a href="/docs/" aria-current={docsActive ? "page" : undefined}>Docs</a>
    <a href="/docs/architecture/daemon-federation/">Architecture</a>
    <a href="/docs/reference/cli/">Reference</a>
  </nav>
  <div class="header-actions">
    <button class="icon-button" type="button" data-search-open aria-label="Search documentation" data-tooltip="Search documentation">
      <img src="/icons/search.svg" alt="" width="18" height="18" />
    </button>
    <a class="icon-link" href={REPOSITORY_URL} aria-label="eBrain on GitHub" data-tooltip="GitHub">
      <img src="/icons/github.svg" alt="" width="18" height="18" />
    </a>
  </div>
</header>
