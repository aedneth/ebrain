# Supply-chain settings only. NEVER put a token or credential in this file.
#
# save-exact       dependency changes are reviewed code changes, so a range is not enough.
# ignore-scripts   a lifecycle script runs arbitrary code at install time, before any review.
# min-release-age  refuse a dependency version published in the last 2 days, so a compromised
#                  publish has to survive public scrutiny before it can reach this repository.
save-exact=true
ignore-scripts=true
min-release-age=2
