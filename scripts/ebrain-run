#!/usr/bin/env bash
# ebrain-run — launcher seguro del motor interno gbrain.
# Superficie ebrain-owned; el motor sigue siendo vendor/gbrain.
set -euo pipefail
WD="$HOME/.config/ebrain/wd"
mkdir -p "$WD"
cd "$WD"
ENV_FILE="$HOME/.config/ebrain/.env"
if [ -f "$ENV_FILE" ]; then
  set -a
  # shellcheck disable=SC1090
  . "$ENV_FILE"
  set +a
fi
export GBRAIN_SKILLS_DIR="$HOME/.config/ebrain/skills"
export GBRAIN_CHAT_MODEL="${GBRAIN_CHAT_MODEL:-openrouter:minimax/minimax-m3}"
BUN_BIN="${BUN_BIN:-$HOME/.bun/bin/bun}"
command -v bun >/dev/null 2>&1 && BUN_BIN=bun
exec "$BUN_BIN" run "$HOME/eBrain/vendor/gbrain/src/cli.ts" "$@"
