#!/usr/bin/env bash
# Thin executable entrypoint; structured parsing and isolation live in cli/query.ts.
set -euo pipefail

EBRAIN_HOME="${EBRAIN_HOME:-$HOME/eBrain}"
BUN_BIN="${BUN_BIN:-$HOME/.bun/bin/bun}"
command -v bun >/dev/null 2>&1 && BUN_BIN=bun

exec "$BUN_BIN" run "$EBRAIN_HOME/cli/query.ts" "$@"
