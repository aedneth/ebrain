#!/usr/bin/env bash
# ebrain-brain — host launcher del daemon de cerebro compartido (FASE D / ADR-004).
# Corre el motor gbrain como UN server HTTP-MCP persistente, dueño único del lock
# single-writer de PGLite; todos los agentes se conectan por MCP-HTTP (sin lock por-agente).
# Proceso en FOREGROUND — `ebrain daemon start` maneja el background + pidfile.
# Mismo patrón de env que ebrain-mcp/ebrain-run (cwd neutral + sourcea la key).
# NO lleva MCP_STDIO=1 (eso es el modo stdio); esto es HTTP en loopback.
set -euo pipefail
# Resolve the checkout BEFORE the cd below — a relative $BASH_SOURCE would not survive it.
# Resolve our own symlink FIRST: a launcher symlinked onto PATH has a BASH_SOURCE pointing at the
# symlink, so `dirname`/../harness would look for the resolver next to the link, not next to the
# real script, and the source would fail before the resolver could do anything (pass 5, F-S3).
# `readlink -f` is coreutils; where it is absent this degrades to the previous behaviour.
EBRAIN_SELF="${BASH_SOURCE[0]}"
# `|| true` and an `if` rather than an `&&` chain: under `set -e` a trailing failed `&&` would
# abort the launcher on any system where readlink lacks -f, turning a graceful degradation into
# a hard failure.
EBRAIN_REAL="$(readlink -f -- "$EBRAIN_SELF" 2>/dev/null || true)"
if [ -n "$EBRAIN_REAL" ]; then EBRAIN_SELF="$EBRAIN_REAL"; fi
. "$(dirname -- "$EBRAIN_SELF")/../harness/core/ebrain-home.sh"
ebrain_export_home "$EBRAIN_SELF"
cd "$HOME/.config/ebrain/wd"          # cwd neutral: bun no auto-carga un .env ajeno
ENV_FILE="$HOME/.config/ebrain/.env"
if [ -f "$ENV_FILE" ]; then set -a; . "$ENV_FILE"; set +a; fi
TOKEN_FILE="$HOME/.config/ebrain/mcp-token.env"
if [ -f "$TOKEN_FILE" ]; then set -a; . "$TOKEN_FILE"; set +a; fi
export GBRAIN_SKILLS_DIR="$HOME/.config/ebrain/skills"
# F4.8 — chat LLM → OpenRouter (para que el tool MCP `think` funcione). Embeddings intactos.
export GBRAIN_CHAT_MODEL="${GBRAIN_CHAT_MODEL:-openrouter:minimax/minimax-m3}"
PORT="${EBRAIN_BRAIN_PORT:-8541}"
BUN_BIN="${BUN_BIN:-$HOME/.bun/bin/bun}"
command -v bun >/dev/null 2>&1 && BUN_BIN=bun
"$BUN_BIN" run "$EBRAIN_HOME/cli/up.ts" ensure-token --boot --quiet
if [ -f "$TOKEN_FILE" ]; then set -a; . "$TOKEN_FILE"; set +a; fi
# Isolation gate: refuse to bind HTTP if any denied source reached the federated set.
"$BUN_BIN" run "$EBRAIN_HOME/cli/daemon-preflight.ts" --quiet
exec "$BUN_BIN" run "$EBRAIN_HOME/vendor/gbrain/src/cli.ts" serve --http --port "$PORT" --bind 127.0.0.1
