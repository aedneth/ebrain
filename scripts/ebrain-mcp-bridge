#!/usr/bin/env bash
# ebrain-mcp-bridge — stdio MCP bridge to the shared HTTP daemon.
# Adapter configs store this command only; the token is read from ebrain's
# chmod-600 token store at runtime.
set -euo pipefail

. "$(dirname -- "${BASH_SOURCE[0]}")/../harness/core/ebrain-home.sh"
EBRAIN_HOME="$(ebrain_resolve_home "${BASH_SOURCE[0]}")"
BUN_BIN="${BUN_BIN:-$HOME/.bun/bin/bun}"
command -v bun >/dev/null 2>&1 && BUN_BIN=bun
exec "$BUN_BIN" run "$EBRAIN_HOME/cli/mcp-bridge.ts" "$@"
