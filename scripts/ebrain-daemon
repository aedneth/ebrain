#!/usr/bin/env bash
# ebrain-daemon — control of the shared-brain host (ADR-004).
# Subcommands: start | stop | status | restart | ensure.
#
# The host is ONE `gbrain serve --http` on loopback that owns the PGLite single-writer lock.
# This launcher is a thin wrapper, exactly like ebrain-up: the protocol itself (identity-verified
# pidfile, atomic start lock, health-gated start, log rotation) lives in cli/daemon-control.ts,
# where it is unit-testable and behaves the same on every platform.
set -euo pipefail

# Resolve our own symlink FIRST: a launcher symlinked onto PATH has a BASH_SOURCE pointing at the
# symlink, so `dirname`/../harness would look for the resolver next to the link, not next to the
# real script, and the source would fail before the resolver could do anything (pass 5, F-S3).
# `readlink -f` is coreutils; where it is absent this degrades to the previous behaviour.
EBRAIN_SELF="${BASH_SOURCE[0]}"
# `|| true` and an `if` rather than an `&&` chain: under `set -e` a trailing failed `&&` would
# abort the launcher on any system where readlink lacks -f, turning a graceful degradation into
# a hard failure.
EBRAIN_REAL="$(readlink -f -- "$EBRAIN_SELF" 2>/dev/null || true)"
if [ -n "$EBRAIN_REAL" ]; then EBRAIN_SELF="$EBRAIN_REAL"; fi
. "$(dirname -- "$EBRAIN_SELF")/../harness/core/ebrain-home.sh"
ebrain_export_home "$EBRAIN_SELF"

# No dotenv and no token file is sourced here: controlling the host needs neither. /health is
# unauthenticated and the host mints its own credentials at boot, so this process never holds
# secret material.

BUN_BIN="${BUN_BIN:-$HOME/.bun/bin/bun}"
command -v bun >/dev/null 2>&1 && BUN_BIN=bun

exec "$BUN_BIN" run "$EBRAIN_HOME/cli/daemon-control.ts" "$@"
