#!/usr/bin/env bash
# ebrain-daemon — supervisa el host de cerebro compartido (FASE D / ADR-004).
# Subcomandos: start | stop | status | restart.
# El host es UN `gbrain serve --http` en loopback dueño del lock PGLite. Este control
# maneja pidfile + single-instance + un GUARD del lock single-writer (si hay un `serve`
# stdio vivo, arrancar el host se colgaría → se rehúsa con puntero al runbook de cutover).
set -uo pipefail

# Resolve our own symlink FIRST: a launcher symlinked onto PATH has a BASH_SOURCE pointing at the
# symlink, so `dirname`/../harness would look for the resolver next to the link, not next to the
# real script, and the source would fail before the resolver could do anything (pass 5, F-S3).
# `readlink -f` is coreutils; where it is absent this degrades to the previous behaviour.
EBRAIN_SELF="${BASH_SOURCE[0]}"
# `|| true` and an `if` rather than an `&&` chain: under `set -e` a trailing failed `&&` would
# abort the launcher on any system where readlink lacks -f, turning a graceful degradation into
# a hard failure.
EBRAIN_REAL="$(readlink -f -- "$EBRAIN_SELF" 2>/dev/null || true)"
if [ -n "$EBRAIN_REAL" ]; then EBRAIN_SELF="$EBRAIN_REAL"; fi
. "$(dirname -- "$EBRAIN_SELF")/../harness/core/ebrain-home.sh"
ebrain_export_home "$EBRAIN_SELF"

CFG="$HOME/.config/ebrain"
PIDFILE="$CFG/ebrain-brain.pid"
LOG="$CFG/daemon.log"
PORT="${EBRAIN_BRAIN_PORT:-8541}"

# Launcher: copia instalada en $CFG, con fallback al repo (para correr pre-install).
LAUNCHER="$CFG/ebrain-brain"
[ -x "$LAUNCHER" ] || LAUNCHER="$EBRAIN_HOME/scripts/ebrain-brain"

is_running() {
  [ -f "$PIDFILE" ] || return 1
  local pid; pid="$(cat "$PIDFILE" 2>/dev/null)"
  [ -n "$pid" ] && kill -0 "$pid" 2>/dev/null
}

health() { curl -fsS -m 3 "http://127.0.0.1:$PORT/health" >/dev/null 2>&1; }

# ¿Hay un `gbrain serve` (stdio) vivo que NO sea nuestro host? Tiene el lock PGLite.
stdio_serve_alive() {
  local ours; ours="$(cat "$PIDFILE" 2>/dev/null || echo -1)"
  local p
  for p in $(pgrep -f "cli.ts serve" 2>/dev/null); do
    [ "$p" = "$ours" ] && continue
    return 0
  done
  return 1
}

case "${1:-status}" in
  start)
    if is_running; then echo "ebrain daemon: ya corre (PID $(cat "$PIDFILE")) · :$PORT"; exit 0; fi
    if stdio_serve_alive; then
      echo "ebrain daemon: hay un 'gbrain serve' (stdio) vivo con el lock single-writer de PGLite." >&2
      echo "  El host HTTP se colgaría esperando el lock. Cerrá las sesiones MCP stdio primero" >&2
      echo "  (incluida la de Claude Code orquestador). Ver runbook de cutover D.6 en docs/SPRINT-DAEMON.md." >&2
      exit 1
    fi
    if [ ! -x "$LAUNCHER" ]; then echo "ebrain daemon: launcher no encontrado ($LAUNCHER)" >&2; exit 127; fi
    mkdir -p "$CFG"
    echo "ebrain daemon: arrancando host en 127.0.0.1:$PORT …"
    # `setsid` separa el process group del shell/harness que invoca este control.
    # `nohup` solo ignora SIGHUP; algunos runners limpian el process group con
    # SIGTERM al cerrar la llamada, lo que tumbaba el host segundos después.
    if command -v setsid >/dev/null 2>&1; then
      setsid "$LAUNCHER" >>"$LOG" 2>&1 &
    else
      nohup "$LAUNCHER" >>"$LOG" 2>&1 &
    fi
    echo $! > "$PIDFILE"
    sleep 1
    if is_running; then
      echo "ebrain daemon: UP (PID $(cat "$PIDFILE")) · log: $LOG"
    else
      echo "ebrain daemon: falló al arrancar (ver $LOG)" >&2; rm -f "$PIDFILE"; exit 1
    fi
    ;;
  stop)
    if ! is_running; then echo "ebrain daemon: no corre"; rm -f "$PIDFILE"; exit 0; fi
    pid="$(cat "$PIDFILE")"
    kill "$pid" 2>/dev/null
    for _ in 1 2 3 4 5 6 7 8; do is_running || break; sleep 1; done
    if is_running; then kill -9 "$pid" 2>/dev/null; fi
    rm -f "$PIDFILE"
    echo "ebrain daemon: DOWN"
    ;;
  status)
    if is_running; then
      if health; then
        echo "ebrain daemon: UP (PID $(cat "$PIDFILE")) · :$PORT healthy"
      else
        echo "ebrain daemon: PID $(cat "$PIDFILE") vivo pero :$PORT no responde /health (¿arrancando?)"
      fi
    else
      echo "ebrain daemon: DOWN"
      exit 3
    fi
    ;;
  restart)
    "$0" stop
    "$0" start
    ;;
  *)
    echo "uso: ebrain daemon {start|stop|status|restart}" >&2
    exit 2
    ;;
esac
