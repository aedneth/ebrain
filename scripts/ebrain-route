#!/usr/bin/env bash
# ebrain-route — launcher de `ebrain route` (one-shot ruteado sobre el stack OpenRouter capado).
# Carga el entorno privado (.env) para que cli/route.ts tenga la key del provider sin imprimirla.
#
# Pass 6 (F-T5): antes esto vivía SOLO como una copia en $HOME/.config/ebrain/ebrain-route creada a
# mano según scripts/README.md — que install.sh nunca corría. Un usuario recién instalado tenía
# `ebrain route` roto (exit 127) y `ebrain doctor` con 10 FAILs. Ahora es un launcher versionado,
# hermano de ebrain-run/ebrain-up, y vive en el checkout como los demás.
set -euo pipefail

# Resolve our own symlink FIRST (pass 5, F-S3): a launcher symlinked onto PATH has a BASH_SOURCE
# pointing at the symlink, so sourcing `../harness/...` would look next to the link, not the script.
EBRAIN_SELF="${BASH_SOURCE[0]}"
EBRAIN_REAL="$(readlink -f -- "$EBRAIN_SELF" 2>/dev/null || true)"
if [ -n "$EBRAIN_REAL" ]; then EBRAIN_SELF="$EBRAIN_REAL"; fi
. "$(dirname -- "$EBRAIN_SELF")/../harness/core/ebrain-home.sh"
ebrain_export_home "$EBRAIN_SELF"

CFG="$HOME/.config/ebrain"
WD="$CFG/wd"
mkdir -p "$WD"
cd "$WD"

ENV_FILE="$CFG/.env"
if [ -f "$ENV_FILE" ]; then
  set -a
  # shellcheck disable=SC1090
  . "$ENV_FILE"
  set +a
fi

BUN_BIN="${BUN_BIN:-$HOME/.bun/bin/bun}"
command -v bun >/dev/null 2>&1 && BUN_BIN=bun
exec "$BUN_BIN" run "$EBRAIN_HOME/cli/route.ts" "$@"
